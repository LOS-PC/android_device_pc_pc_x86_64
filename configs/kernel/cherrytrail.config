# Intel Bay Trail / Cherry Trail SoCs (Atom Z3700 / x5-Z8x00 tablets).
# Without the GPIO, LPSS, I2C and PMIC drivers the eMMC, panel power and backlight
# don't come up, so everything here is built in.

# GPIO
CONFIG_PINCTRL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y

# Low Power Subsystem: I2C, PWM, DMA
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_IOSF_MBI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_DW_DMAC=y
CONFIG_PWM=y
CONFIG_PWM_LPSS_PLATFORM=y
CONFIG_PWM_LPSS_PCI=y

# PMICs (which one depends on the board) and their ACPI OpRegions, which the
# firmware uses to power the panel and eMMC
CONFIG_INTEL_SOC_PMIC=y
CONFIG_INTEL_SOC_PMIC_CHTWC=y
CONFIG_INTEL_SOC_PMIC_CHTDC_TI=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_PMIC_OPREGION=y
CONFIG_BYTCRC_PMIC_OPREGION=y
CONFIG_CHTCRC_PMIC_OPREGION=y
CONFIG_XPOWER_PMIC_OPREGION=y
CONFIG_CHT_WC_PMIC_OPREGION=y
CONFIG_CHT_DC_TI_PMIC_OPREGION=y
CONFIG_PWM_CRC=y

# AXP288 battery, charger and USB detection
CONFIG_IIO=y
CONFIG_AXP288_ADC=y
CONFIG_EXTCON=y
CONFIG_EXTCON_AXP288=y
CONFIG_AXP288_CHARGER=y
CONFIG_AXP288_FUEL_GAUGE=y

# Platform glue
CONFIG_INTEL_INT0002_VGPIO=y
CONFIG_INTEL_SOC_DTS_THERMAL=y
# Power / volume buttons
CONFIG_INPUT_MISC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_SOC_BUTTON_ARRAY=y
