# Generic x86_64 PC hardware. Boot-critical drivers are built in.

# 64-bit kernel booted by 32-bit UEFI firmware (BOOTIA32.EFI)
CONFIG_EFI_MIXED=y

# Firmware framebuffer as a DRM device. Shows the boot console until a GPU driver
# takes over, and is the display for software rendering on GPUs without a driver
# (NVIDIA, AMD for now).
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# Storage
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
# Intel controllers in IDE mode (older chipsets, or AHCI turned off in the firmware)
CONFIG_ATA_PIIX=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
# Realtek card readers (PCIe and USB), common in laptops and desktops
CONFIG_MISC_RTSX_PCI=y
CONFIG_MISC_RTSX_USB=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_MMC_REALTEK_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Graphics
# Intel: modules, since they need firmware from /vendor (vendor/pc/firmware/i915, xe): the
# display engine's (DMC) for its power saving states on Skylake and newer, and the GuC / HuC
# without which Alder Lake-P and newer can't run the GPU. i915 drives Gen 4 to Meteor Lake,
# xe Lunar Lake and newer.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
# NVIDIA: a module, for its firmware on /vendor (vendor/pc/firmware/nvidia: Pascal to Ada).
# GSP firmware by default, which Ada always uses: without it Turing and Ampere run at their
# boot clocks.
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_NOUVEAU_GSP_DEFAULT=y
# AMD: a module, since it can't start without its firmware, which is on /vendor.
# SI / CIK (GCN 1 / 2) cards too, which the old radeon driver would otherwise take.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
# ACPI video (backlight, brightness keys) and the laptop drivers below need WMI built in;
# the built-in i915 used to select it, the module doesn't
CONFIG_ACPI_WMI=y
CONFIG_WMI_BMOF=y
CONFIG_ACPI_VIDEO=y

# Ethernet (the Intel drivers need PTP built in to be built in themselves)
CONFIG_PTP_1588_CLOCK=y
CONFIG_R8169=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y

# Power. Laptops report their battery and charger through ACPI (the embedded controller
# behind it talks to the actual chips); a few older ones and Intel Macs use Smart Battery
# System (SBS) instead.
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_SBS=y
CONFIG_ACPI_BUTTON=y
CONFIG_INTEL_IDLE=y
# Suspend to idle on AMD laptops
CONFIG_AMD_PMC=y

# Laptop vendor drivers: hotkeys (brightness, mute, airplane mode), keyboard backlight,
# battery charge limits, fans, and the backlight on laptops whose firmware doesn't control
# it through ACPI. Built in: they check the machine and do nothing on other vendors'
# laptops. rfkill and hwmon (modules in gki_defconfig) have to be built in for them.
CONFIG_RFKILL=y
CONFIG_HWMON=y
CONFIG_INTEL_HID_EVENT=y
CONFIG_INTEL_VBTN=y
CONFIG_THINKPAD_ACPI=y
CONFIG_IDEAPAD_LAPTOP=y
CONFIG_ASUS_LAPTOP=y
CONFIG_ASUS_WMI=y
CONFIG_ASUS_NB_WMI=y
CONFIG_EEEPC_LAPTOP=y
CONFIG_EEEPC_WMI=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_RBTN=y
CONFIG_DELL_WMI_DDV=y
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_WMI=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y
CONFIG_ACER_WMI=y
CONFIG_MSI_EC=y
CONFIG_MSI_LAPTOP=y
CONFIG_MSI_WMI=y
CONFIG_HUAWEI_WMI=y
CONFIG_SAMSUNG_LAPTOP=y
CONFIG_ACPI_TOSHIBA=y
CONFIG_SONY_LAPTOP=y
CONFIG_FUJITSU_LAPTOP=y
CONFIG_PANASONIC_LAPTOP=y
CONFIG_LG_LAPTOP=y
CONFIG_SYSTEM76_ACPI=y
CONFIG_XIAOMI_WMI=y
CONFIG_COMPAL_LAPTOP=y
CONFIG_TOPSTAR_LAPTOP=y

# Intel Macs: backlight on dual-GPU MacBook Pros, fans and sensors
CONFIG_APPLE_GMUX=y
CONFIG_SENSORS_APPLESMC=y

# Chromebooks with UEFI firmware: the ChromeOS embedded controller (charger, USB-C power)
CONFIG_CHROME_PLATFORMS=y
CONFIG_CROS_EC=y
CONFIG_CROS_EC_LPC=y
CONFIG_MFD_CROS_EC_DEV=y
CONFIG_CHARGER_CROS_USBPD=y

# Microsoft Surface Laptop / Book: battery, charger and keyboard are behind the Surface
# Aggregator Module, on a serial port (8250_dw)
CONFIG_SERIAL_8250_DW=y
CONFIG_SURFACE_AGGREGATOR=y
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=y
CONFIG_SURFACE_ACPI_NOTIFY=y
CONFIG_SURFACE_GPE=y
CONFIG_SURFACE_PLATFORM_PROFILE=y
CONFIG_BATTERY_SURFACE=y
CONFIG_CHARGER_SURFACE=y
CONFIG_SURFACE_HID=y
CONFIG_SURFACE_KBD=y

# Battery, charger and fuel gauge chips on I2C, which some laptops' firmware leaves to the OS
CONFIG_BATTERY_SBS=y
CONFIG_CHARGER_SBS=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_BATTERY_MAX17042=y
CONFIG_CHARGER_BQ24190=y
CONFIG_CHARGER_BQ25890=y

# Input
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID_ACPI=y

# I2C touchpads: the I2C controllers (DesignWare / LPSS) are in cherrytrail.config, but the
# touchpad's interrupt is a GPIO pin, so without the chipset's GPIO driver it never probes.
# AMD (Carrizo / Stoney and later), then Intel Haswell through Lunar Lake
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_LYNXPOINT=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
# Touchpads with their own drivers: Elan and Synaptics ones start in PS/2 mode and switch to
# I2C / SMBus (through the chipset's SMBus controller) for multi-finger gestures
CONFIG_I2C_I801=y
CONFIG_I2C_PIIX4=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_MOUSE_CYAPA=y
CONFIG_HID_ALPS=y
CONFIG_HID_ASUS=y
CONFIG_HID_LENOVO=y
# MacBook trackpads (USB)
CONFIG_MOUSE_BCM5974=y

# Audio: HD Audio controllers and the codecs found on PC motherboards and laptops, plus
# HDMI / DisplayPort audio on GPUs. Without its codec driver, a codec falls back to the
# generic parser, which often misroutes jacks.
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CS8409=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SENARYTECH=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_SI3054=y
CONFIG_SND_HDA_GENERIC_LEDS=y
CONFIG_SND_HDA_INPUT_BEEP=y
# Codec quirks without rebuilding: hda-jack-retask style fixups loaded as firmware
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_PATCH_LOADER=y

# Wi-Fi: modules, loaded once /vendor is there (their firmware is in /vendor/firmware), all of
# them, since Android doesn't load drivers when a device shows up. USB adapters plugged in
# later still bind to the loaded driver. See BOARD_VENDOR_KERNEL_MODULES_LOAD.
CONFIG_MAC80211=m
# Realtek: rtw88 / rtw89 (PCIe and USB), rtl8xxxu (older USB: 8188CU / EU, 8192CU / EU,
# 8723BU, ...), rtlwifi (older PCIe)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8821CU=m
# RTL8821AU / RTL8812AU (e.g. TP-Link Archer T2U), backported from 6.13 to kernel/pc/pc
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_RTL8XXXU=m
# Many 8188CU / 8192CU adapters are only listed with this
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL_CARDS=m
CONFIG_RTL8188EE=m
CONFIG_RTL8192EE=m
CONFIG_RTL8723BE=m
CONFIG_RTL8821AE=m
# MediaTek (mt76)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
# Qualcomm Atheros
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# Intel
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
# Broadcom
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_PCIE=y
# Ralink / MediaTek (older USB and PCI)
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800PCI=m

# Bluetooth over USB: firmware loaders for the common combo chips
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
