import /vendor/etc/init/hw/init.virt.rc

# Partitions are found by their GPT names (androidboot.boot_devices=any),
# so no per-disk symlinks are needed.
on fs
    mkdir /mnt/vendor/EFI 0770 root root
    mkdir /mnt/vendor/persist 0770 system system

    # Mount everything that does not require fsck
    mount_all --early

    # Logs (pc_save_logs.sh): the pc_logs partition stays mounted, with sync so a reset
    # can't leave half-written logs
    mkdir /mnt/vendor/pc_logs 0770 root root
    mount vfat /dev/block/by-name/pc_logs /mnt/vendor/pc_logs rw sync noatime shortname=lower context=u:object_r:pc_logs_file:s0
    start vendor.pc_save_logs

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late

# Save the kernel log (with logcat in it, see pc_logcat.rc) to the pc_logs partition on
# every reboot, including Ctrl+Alt+Del (pc_save_logs.sh watch takes it over from the kernel)
service vendor.pc_save_logs /vendor/bin/pc_save_logs.sh watch
    user root
    group root
    oneshot
    disabled

on shutdown
    exec - root root -- /vendor/bin/pc_save_logs.sh save

# Display: save the resolution chosen in Settings (PcSettings) for GRUB, which sets it
# before booting; only used with the firmware framebuffer (simpledrm)
service vendor.grub-editenv-set-pc_display_mode /vendor/bin/grub-editenv /mnt/vendor/persist/grubenv set pc_display_mode=${persist.sys.pc.boot_resolution}
    user system
    group system
    disabled
    oneshot

on property:persist.sys.pc.boot_resolution=*
    start vendor.grub-editenv-set-pc_display_mode

# Bluetooth: pc_bt_detect.sh picks the vendor SKU, and SystemConfig (system_server) reads
# /vendor/etc/permissions/sku_nobluetooth/ when there's no adapter. Runs synchronously
# before zygote, after USB devices had time to show up; set by expansion rather than a
# property trigger, whose action would only run after boot. Root for /dev/kmsg, group system
# to write its marker on the persist partition (owned by system, mode 0770).
on post-fs-data
    exec - root system -- /vendor/bin/pc_bt_detect.sh ${ro.boot.bluetooth:-auto}
    setprop ro.boot.product.vendor.sku ${vendor.pc.sku}

# Audio: unmute the outputs of every sound card and pick the default output and input
# before the audio HAL starts
on early-boot
    exec - audioserver audio -- /vendor/bin/pc_setup_sound

# Audio: the output and input chosen in Settings (PcSettings), "<card>,<device>" or "auto".
# The audio HAL reads them whenever a stream starts.
on property:persist.sys.pc.audio.output=*
    setprop persist.vendor.audio.primary.output ${persist.sys.pc.audio.output}

on property:persist.sys.pc.audio.input=*
    setprop persist.vendor.audio.primary.input ${persist.sys.pc.audio.input}

# GPU: pc_gpu_detect sets ro.vendor.graphics.gpu, ro.vendor.graphics and minigbm's
# backend. It waits for the vendor modules (amdgpu), which dlkm_loader_mainline starts
# loading at init, so it runs later, but still before boot starts the graphics HALs.
on post-fs-data
    exec u:r:vendor_pc_gpu_detect:s0 -- /vendor/bin/pc_gpu_detect

# Intel
on property:ro.vendor.graphics.gpu=intel && property:ro.boot.gpu_workaround=all
    setprop ro.vendor.hwc.drm.avoid_using_alpha_bits_for_framebuffer 1
    setprop ro.vendor.hwc.drm.disable_planes 1

# Intel - mesa
on property:ro.vendor.graphics.gpu=intel && property:ro.vendor.graphics=mesa
    setprop ro.opengles.version 196610

on property:ro.vendor.graphics.gpu=intel && property:ro.vendor.graphics=mesa && property:ro.boot.hardware_vulkan=intel
    setprop ro.hardware.vulkan intel

on property:ro.vendor.graphics.gpu=intel && property:ro.vendor.graphics=mesa && property:ro.boot.hardware_vulkan=intel_hasvk
    setprop ro.hardware.vulkan intel_hasvk

# AMD - mesa (radeonsi, RADV)
on property:ro.vendor.graphics.gpu=amd && property:ro.vendor.graphics=mesa
    setprop ro.opengles.version 196610
    setprop ro.hardware.vulkan radeon

# NVIDIA - mesa (nouveau). No Vulkan driver yet: SwiftShader's would run apps on the CPU,
# and expects buffers the CPU can map, unlike Mesa's in video memory.
# No hardware planes: nouveau rejected drm_hwcomposer's plane tests every frame, and app
# buffers it tried as framebuffers then failed GPU validation in SurfaceFlinger ("fail
# ttm_validate", MMU fault, channel killed, SurfaceFlinger crashed on the home screen).
# SurfaceFlinger composes everything on the GPU instead.
on property:ro.vendor.graphics.gpu=nvidia && property:ro.vendor.graphics=mesa
    setprop ro.opengles.version 196610
    setprop ro.vendor.hwc.drm.disable_planes 1

# Everything else uses software rendering (ro.vendor.graphics=swiftshader, see init.virt.rc)
