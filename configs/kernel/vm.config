# Virtual machine devices (QEMU), so the target can be tested in a VM first
# (scripts like pc_qemu_ia32.sh). They only bind to virtual hardware.

# 9p (host folder sharing)
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# VirtIO devices
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SND_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_VSOCKETS=y

# Sound cards QEMU emulates (ES1370, AC'97); HD Audio is in pc.config
CONFIG_SND_ENS1370=y
CONFIG_SND_INTEL8X0=y
