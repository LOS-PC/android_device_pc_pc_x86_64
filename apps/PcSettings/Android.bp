android_app {
    name: "PcSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "org.lineageos.settings.resources",
    ],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
}
