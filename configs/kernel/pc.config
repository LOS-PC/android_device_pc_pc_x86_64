# Generic x86_64 PC hardware. Boot-critical drivers are built in.

# 64-bit kernel booted by 32-bit UEFI firmware (BOOTIA32.EFI)
CONFIG_EFI_MIXED=y

# Firmware framebuffer as a DRM device. Shows the boot console until a GPU driver
# takes over, and is the display for software rendering on GPUs without a driver
# (NVIDIA, AMD for now).
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# Storage
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Graphics
CONFIG_DRM_I915=y
CONFIG_ACPI_VIDEO=y

# Ethernet (the Intel drivers need PTP built in to be built in themselves)
CONFIG_PTP_1588_CLOCK=y
CONFIG_R8169=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y

# Power
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_INTEL_IDLE=y

# Input
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID_ACPI=y
