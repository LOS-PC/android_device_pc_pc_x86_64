<!-- Desktop windowing. virt-common's tablet overlay already enables it on the internal
     display (config_isDesktopModeSupported, config_canInternalDisplayHostDesktops), and
     android.hardware.type.pc + freeform windows (pc_desktop.xml) make it the default. -->
<resources>
    <!-- Dragging a window to the top edge maximizes it, like on desktop OSes -->
    <bool name="config_dragToMaximizeInDesktopMode">true</bool>

    <!-- Laptops: closing the lid (the kernel's "Lid Switch" input device, SW_LID) turns the
         screen off, and the system then suspends like after the screen timeout. Opening it
         wakes it up again. -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- Headphone and line out jacks: the sound cards report them as input devices
         (SW_HEADPHONE_INSERT, SW_LINEOUT_INSERT, ...), which the audio HAL needs to route
         to them -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>
</resources>
