# mainline-common options, read by virt-common
# Health: services/health, the real battery on laptops and a full one on desktops
TARGET_HEALTH_HAL := pc
# Suspend: laptops suspend when the screen turns off or the lid closes. Desktops stay
# awake, through a wakelock services/health holds when there's no battery.
TARGET_SUPPORTS_SUSPEND := true
# Lights: Lineage's light HAL drives the laptop backlight; PC backlights have no fixed name,
# so it scans /sys/class/backlight (configs/init/ueventd.pc.rc makes them writable)
TARGET_LIGHT_HAL := lineage
TARGET_LIGHT_HAL_SCAN_FOR_BACKLIGHT_DEVICES := true

# Inherit from common
$(call inherit-product, device/virt/virt-common/virt-common.mk)

DEVICE_PATH := device/pc/pc_x86_64

# Graphics (Allocator)
TARGET_GRAPHICS_ALLOCATOR_HAL := minigbm-upstream
TARGET_MINIGBM_PLATFORM := generic
# gbm_mesa backend, for GPUs minigbm has no backend of its own for (amdgpu)
TARGET_MINIGBM_UPSTREAM_ENABLE_GBM_MESA_DRIVER := true

# Graphics (Composer)
TARGET_GRAPHICS_COMPOSER_HAL := drm_hwcomposer
TARGET_DRM_HWCOMPOSER_VARIANT := upstream

# Desktop: a PC with desktop windowing, on top of the tablet base
DEVICE_PACKAGE_OVERLAYS += \
    $(DEVICE_PATH)/overlay

PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/permissions/pc_desktop.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/pc_desktop.xml

# Settings > Display > Screen rotation & resolution
PRODUCT_PACKAGES += \
    PcSettings

# Graphics
PRODUCT_PACKAGES += \
    pc_firmware_amdgpu \
    pc_gpu_detect

# Intel GPU firmware (vendor/pc/firmware/intel_gpu, generated by its update.py)
$(call inherit-product, vendor/pc/firmware/intel_gpu/intel_gpu.mk)

# NVIDIA GPU firmware (vendor/pc/firmware/nvidia, generated by its update.py)
$(call inherit-product, vendor/pc/firmware/nvidia/nvidia.mk)

# Health
PRODUCT_PACKAGES += \
    android.hardware.health-service.pc \
    android.hardware.health-service.pc_recovery

# Bluetooth
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/permissions/pc_no_bluetooth.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/sku_nobluetooth/pc_no_bluetooth.xml \
    $(DEVICE_PATH)/configs/scripts/pc_bt_detect.sh:$(TARGET_COPY_OUT_VENDOR)/bin/pc_bt_detect.sh

# Wi-Fi and Bluetooth firmware (vendor/pc/firmware/wireless, generated by its update.py)
$(call inherit-product, vendor/pc/firmware/wireless/wireless.mk)

# Logs
PRODUCT_PACKAGES += \
    pc_logcat.sh

# Init
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/init/ueventd.pc.rc:$(TARGET_COPY_OUT_VENDOR)/etc/ueventd.pc.rc \
    $(DEVICE_PATH)/configs/init/init.pc.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/hw/init.pc.rc \
    $(DEVICE_PATH)/configs/init/pc_logcat.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/pc_logcat.rc \
    $(DEVICE_PATH)/configs/scripts/pc_save_logs.sh:$(TARGET_COPY_OUT_VENDOR)/bin/pc_save_logs.sh

PRODUCT_PACKAGES += \
    fstab.pc \
    fstab.pc.vendor_ramdisk

# Kernel
TARGET_KERNEL_SOURCE := kernel/pc/pc

# Recovery
PRODUCT_PACKAGES += \
    pc_install_disk_select

PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/configs/init/init.recovery.pc.rc:$(TARGET_COPY_OUT_RECOVERY)/root/init.recovery.pc.rc \
    $(DEVICE_PATH)/configs/scripts/pc_install_logs.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/pc_install_logs.sh \
    $(DEVICE_PATH)/configs/pc_logs/pc_logs.img.gz:$(TARGET_COPY_OUT_RECOVERY)/root/system/etc/pc_logs.img.gz \
    $(DEVICE_PATH)/configs/scripts/pc_save_logs.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/pc_save_logs.sh \
    $(DEVICE_PATH)/configs/scripts/pc_clear_partitions.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/pc_clear_partitions.sh \
    $(DEVICE_PATH)/configs/scripts/pc_create_partition_table.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/pc_create_partition_table.sh

# Uncompressed APEXes: compressed ones are unpacked to /data on first boot, which took 81 s
# from an eMMC and 25 minutes from a USB drive. It costs about 150 MB more in super, which
# has the room.
PRODUCT_COMPRESSED_APEX := false

# Shipping API level
PRODUCT_SHIPPING_API_LEVEL := 36

# Soong namespaces
PRODUCT_SOONG_NAMESPACES += \
    $(DEVICE_PATH)
